{
  "name": "tempest-leads",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "preview": "npm run preview -w client",
    "start": "npm start -w server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "globals": "^16.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.0",
    "@playwright/test": "^1.56.0"
  }
}
